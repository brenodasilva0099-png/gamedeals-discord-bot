DISCORD_TOKEN=cole_no_painel_da_square_cloud_nao_aqui
# Opcional: define caminho para o SQLite
DATA_DIR=./data
# Opcional: intervalo de consulta em minutos (minimo 15)
POLL_MINUTES=30
# Opcional: desconto minimo nas notificacoes
MIN_DISCOUNT=50
# Cada fonte é inicializada separadamente, sem publicar ofertas antigas na primeira coleta.

# Quantos jogos de listas de desejos são consultados por ciclo (1 a 30)
WISHLIST_CHECK_LIMIT=12

# GameDeals Live (habilite somente quando publicar aplicativo como Web na Square Cloud)
ENABLE_LIVE=0
DISCORD_APPLICATION_ID=1569671744803967127
ACTIVITY_PUBLIC_URL=https://SEU-SUBDOMINIO.squareweb.app
# LIVE_ALLOW_UNVERIFIED=1 permitido somente em testes locais
